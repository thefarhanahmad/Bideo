{
  "expo": {
    "name": "Bideo",
    "slug": "bideoApp",
    "scheme": "bideo",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.farhan.bideoapp"
    },
    "android": {
      "package": "com.farhan.bideoapp",
      "googleServicesFile": "./google-services.json",
      "versionCode": 11,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "bideo.in",
              "pathPrefix": "/v"
            },
            {
              "scheme": "https",
              "host": "bideo.in",
              "pathPrefix": "/c"
            },
            {
              "scheme": "https",
              "host": "bideo.in",
              "pathPrefix": "/video"
            },
            {
              "scheme": "https",
              "host": "bideo.in",
              "pathPrefix": "/channel"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF7A00"
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3108167135160132~8755482596",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash_icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash_icon.png",
            "backgroundColor": "#FFFFFF"
          },
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to upload business images.",
          "cameraPermission": "The app accesses your camera to take photos for uploads."
        }
      ],
      "expo-web-browser",
      "expo-video",
      "expo-font",
      "react-native-compressor",
      "./plugins/withAdmobMediation"
    ],
    "experiments": {
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "ADMOB_BANNER_ID": "ca-app-pub-3108167135160132/3447160062",
      "ADMOB_INTERSTITIAL_ID": "ca-app-pub-3108167135160132/8016583160",
      "eas": {
        "projectId": "c9d54950-dd5f-4e87-bf77-fcc184d8bcf7"
      }
    }
  }
}
